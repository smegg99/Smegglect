{
  "name": "smegglect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Development-only visual inspection and annotation overlay for web-rendered interfaces.",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/overlay/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/types/dom/index.d.ts",
      "import": "./dist/dom.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./vite": {
      "types": "./dist/types/vite/index.d.ts",
      "import": "./dist/vite.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt/index.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./wails": {
      "types": "./dist/types/wails/index.d.ts",
      "import": "./dist/wails.js"
    },
    "./bridge": {
      "types": "./dist/types/bridge/index.d.ts",
      "import": "./dist/bridge.js"
    }
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vite build --config vite.node.config.ts && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/js": "7.4.47",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nuxt/kit": "4.6.4",
    "@nuxt/schema": "4.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "vite": ">=6",
    "@nuxt/kit": ">=3.15",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "bin": {
    "smegglect-bridge": "./dist/bridge-cli.js"
  }
}
