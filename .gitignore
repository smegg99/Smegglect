# .gitignore
node_modules/
dist/
# Packed releases, written by `just release`.
release/
test-results/
playwright-report/
# Runtime data written by the optional bridge.
.smegglect/
*.tgz
# Tests, the apps they run against and working notes stay out of the repository. The Wails app stays:
# the guide points to it as the example.
/tests/
/fixtures/*
!/fixtures/wails/
/fixtures/wails/**/*_test.go
/fixtures/wails/bin/
# Its lockfile: the packed tarball changes on every build, so it reinstalls each time.
/fixtures/wails/frontend/bun.lock
/playground/
/src/**/*.test.ts
/src/core/__golden__/
/vitest.config.ts
/playwright.config.ts
/playwright.fixtures.config.ts
/scripts/release-check.ts
/scripts/wails-release-check.ts
/docs/
# The showcase installs the packed library, so its lockfile changes with every build.
showcase/.nuxt/
showcase/.output/
showcase/bun.lock
