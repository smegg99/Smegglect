# .gitignore
node_modules/
dist/
# Packed releases, written by `just release`.
release/
test-results/
playwright-report/
# Runtime data written by the optional bridge.
.smegglect/
*.tgz
fixtures/*/node_modules/
fixtures/*/.nuxt/
fixtures/*/.output/
fixtures/*/dist
fixtures/*/bin/
fixtures/*/build/bin/
fixtures/*/frontend/dist/
fixtures/*/frontend/node_modules/
# Fixture lockfiles: the packed tarball changes on every build, so fixtures reinstall each time.
fixtures/*/bun.lock
fixtures/*/frontend/bun.lock
fixtures/pack/
# The showcase installs the packed library too, so its lockfile changes with every build.
showcase/.nuxt/
showcase/.output/
showcase/bun.lock
fixtures/*/dist-debug/
