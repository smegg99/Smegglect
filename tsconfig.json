{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "paths": {
      "smegglect": [
        "./src/overlay/index.ts"
      ],
      "smegglect/core": [
        "./src/core/index.ts"
      ],
      "smegglect/dom": [
        "./src/dom/index.ts"
      ],
      "smegglect/vue": [
        "./src/vue/index.ts"
      ],
      "smegglect/vite": [
        "./src/vite/index.ts"
      ],
      "smegglect/nuxt": [
        "./src/nuxt/index.ts"
      ],
      "smegglect/wails": [
        "./src/wails/index.ts"
      ],
      "smegglect/bridge": [
        "./src/bridge/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "playground",
    "tests",
    "*.config.ts"
  ]
}
